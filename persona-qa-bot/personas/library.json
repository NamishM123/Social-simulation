    "traits": { "patience": 1.0 },
    "steps": [
      { "action": "goto", "url": "/" },
      { "action": "type", "selector": "#search", "value": "<script>alert(1)</script>" },
      { "action": "press", "key": "Enter" },
      { "action": "type", "selector": "#search", "value": "' OR 1=1 --" },
      { "action": "press", "key": "Enter" }
    ]
  },
