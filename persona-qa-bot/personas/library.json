    "steps": [
      { "action": "goto", "url": "/items/new" },
      { "action": "type", "selector": "#item-name", "value": "sync-check-abc123" },
      { "action": "click", "selector": "text=Save" },
      { "action": "goto", "url": "/items" },
      { "action": "expectText", "text": "sync-check-abc123" }
    ]
  },
  {
    "name": "Security probe",
    "goal": "Tries XSS/SQLi-ish inputs in fields",
