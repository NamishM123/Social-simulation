    "mode": "script",
    "traits": { "patience": 2.0, "typingDelayMs": 90, "thinkMsRange": [400, 1200] },
    "steps": [
      { "action": "goto", "url": "/" },
      { "action": "type", "selector": "#email", "value": "qa+careful@example.com" },
      { "action": "type", "selector": "#password", "value": "Test1234!" },
      { "action": "click", "selector": "button[type=submit]" },
      { "action": "expectVisible", "selector": "[data-testid=home]" }
    ]
  },
  {
    "name": "Impatient power user",
